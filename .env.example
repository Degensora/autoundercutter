# ---- Server ----
PORT=3000
DATA_DIR=./data

# ---- Marketplace connection ----
# ticketattendant = your real Ticket Attendant Terminal account (prices sync to StubHub etc. through TA)
# mock            = simulated market, nothing real is touched (default when no TA credentials are set)
MARKETPLACE=ticketattendant

# ---- Ticket Attendant Terminal login ----
TA_BASE_URL=https://terminal.ticketattendant.com
TA_USERNAME=you@example.com
TA_PASSWORD=your-password
# Optional fallback instead of username/password: paste the Cookie header from your browser session.
# Session cookies expire (usually within a day), so username/password is strongly preferred.
# TA_COOKIE=.ASPXAUTH=...; ASP.NET_SessionId=...

# How many 50-row pages of StubHub listings to read per section (lowest prices come first)
TA_MAX_MARKET_PAGES=2

# ---- Mock market tuning (only used when MARKETPLACE=mock) ----
MOCK_VOLATILITY=0.25
